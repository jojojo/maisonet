{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "mobile:build": "vite build --config vite.mobile.config.ts",
        "mobile:sync": "npm run mobile:build && cap sync",
        "mobile:android": "npm run mobile:sync && cap open android",
        "mobile:ios": "npm run mobile:sync && cap open ios"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.3",
        "@eslint/js": "^9.19.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.1.0",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@aparajita/capacitor-secure-storage": "^8.0.1",
        "@capacitor/android": "^8.5.3",
        "@capacitor/app": "^8.1.2",
        "@capacitor/browser": "^8.0.5",
        "@capacitor/core": "^8.5.3",
        "@capacitor/ios": "^8.5.3",
        "@fontsource/nunito": "^5.3.0",
        "@inertiajs/react": "^3.9.1",
        "@types/react": "^19.0.3",
        "@types/react-dom": "^19.0.2",
        "@vitejs/plugin-react": "^4.3.4",
        "bootstrap": "5.3.8",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "core-js": "^3.51.0",
        "globals": "^15.14.0",
        "intersection-observer": "^0.12.2",
        "laravel-vite-plugin": "^1.0",
        "lucide-react": "^0.475.0",
        "react": "^19.0.0",
        "react-bootstrap": "2.10.10",
        "react-dom": "^19.0.0",
        "resize-observer-polyfill": "^1.5.1",
        "typescript": "^5.7.2",
        "vite": "^6.0",
        "ziggy-js": "^2.6.5"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
